% Prefer the reference deck's macOS fonts; use TeX Live fonts when unavailable.
\usepackage{fontspec}
\usepackage{unicode-math}
\IfFontExistsTF{Helvetica Neue}{
  \setmainfont{Helvetica Neue}\setsansfont{Helvetica Neue}
}{\setmainfont{TeX Gyre Heros}\setsansfont{TeX Gyre Heros}}
\IfFontExistsTF{Menlo}{\setmonofont{Menlo}}{\setmonofont{Latin Modern Mono}}
\IfFontExistsTF{STIX Two Math}{\setmathfont{STIX Two Math}}{\setmathfont{Latin Modern Math}}
\IfFileExists{/System/Library/Fonts/Supplemental/Songti.ttc}{
  \setCJKmainfont{Songti.ttc}[Path=/System/Library/Fonts/Supplemental/]
}{\setCJKmainfont{FandolSong-Regular}[BoldFont=FandolSong-Bold]}
\IfFontExistsTF{PingFang SC}{\setCJKsansfont{PingFang SC}}{
  \setCJKsansfont{FandolHei-Regular}[BoldFont=FandolHei-Bold]
}
\IfFontExistsTF{Arial Unicode MS}{\setCJKmonofont{Arial Unicode MS}}{
  \setCJKmonofont{FandolFang-Regular}
}
\setbeamerfont{title}{size=\huge}
\setbeamerfont{frametitle}{size=\Large}
