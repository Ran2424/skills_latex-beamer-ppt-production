\usepackage{color}

\usecolortheme{whale}
\usecolortheme{orchid}

\definecolor{TJBluePrimary}{HTML}{365F9F}
\definecolor{TJBlueSecondary}{HTML}{002060}
\definecolor{TJRed}{RGB}{250, 2, 1}
\definecolor{TBlack}{RGB}{0, 0, 0}
\definecolor{TWhite}{RGB}{255, 255, 255}

% "bg=" make it transparent
\setbeamercolor{title}{fg=TJBluePrimary, bg=}
\setbeamercolor{frametitle}{fg=black}
\setbeamercolor{caption name}{fg=TJBluePrimary}
\setbeamercolor{structure}{fg=TJBluePrimary}
\setbeamercolor{item}{fg=TJBluePrimary}
\setbeamercolor{subitem}{fg=TJBluePrimary}
\setbeamercolor{alerted text}{fg=TJBlueSecondary}
\setbeamercolor{section in toc}{fg=TJBluePrimary}
\setbeamercolor{block title}{fg=TWhite, bg=TJBluePrimary}
\setbeamercolor{block body}{fg=TBlack, bg=}

\setbeamercolor{author in head/foot}{fg=TWhite, bg=TJBluePrimary}
\setbeamercolor{title in head/foot}{fg=TWhite, bg=TJBluePrimary}
\setbeamercolor{date in head/foot}{fg=TWhite, bg=TJBlueSecondary}
\setbeamercolor{institute in head/foot}{fg=TWhite, bg=TJBlueSecondary}
\setbeamercolor{section in head/foot}{fg=TWhite, bg=TJBluePrimary}
\setbeamercolor{subsection in head/foot}{fg=TWhite, bg=TJBlueSecondary}

% Set font color for bibliography items to specified colors
\setbeamercolor{bibliography item}{fg=TJBluePrimary, bg=}
\setbeamercolor{bibliography entry author}{fg=TJBluePrimary, bg=}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}

% Shared neutral text and agenda highlight; diagram semantics belong to each deck.
\definecolor{Ink}{HTML}{33404B}
\definecolor{Muted}{HTML}{66717C}
\definecolor{TJAgendaActive}{RGB}{204,0,0}
\setbeamercolor{normal text}{fg=Ink,bg=white}

% Opaque equivalents of the original corner chips composited on white.
\definecolor{TJChipGray}{HTML}{4B4B4B}
\definecolor{TJChipBlue}{HTML}{0070C0}
\definecolor{TJChipNavy}{HTML}{334D80}
\definecolor{TJChipPale}{HTML}{82ACD3}

% Optional hierarchy colors; these aliases do not recolor the master automatically.
\colorlet{TJLevelText}{TJChipGray}
\colorlet{TJLevelSecondary}{TJChipBlue}
\colorlet{TJLevelPrimary}{TJChipNavy}
\colorlet{TJLevelSoft}{TJChipPale}
% Additional emphasis color; the four-chip identity keeps its original colors.
\definecolor{TJOptionalRed}{HTML}{C43C39}
