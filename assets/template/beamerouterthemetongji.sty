% Local presentation adaptation, 2026-10-15: user-provided PowerPoint reference.
\setbeamertemplate{headline}{}
\setbeamertemplate{navigation symbols}{}
\usebackgroundtemplate{}
\setbeamertemplate{frametitle}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[black!48] ([xshift=.69cm,yshift=-.58cm]current page.north west)
      rectangle ++(.14cm,-.54cm);
    \node[anchor=west,text=black,font=\fontsize{17}{21}\selectfont\bfseries]
      at ([xshift=.94cm,yshift=-.85cm]current page.north west) {\insertframetitle};
    \draw[black!48,line width=.3pt]
      ([xshift=.69cm,yshift=-1.27cm]current page.north west)
      --([xshift=11.38cm,yshift=-1.27cm]current page.north west);
    \node[anchor=north east,inner sep=0pt]
      at ([xshift=-.45cm,yshift=-.62cm]current page.north east)
      {\TongjiHeaderBrand};
  \end{tikzpicture}%
  \vspace*{.80cm}%
}
\setbeamertemplate{footline}{%
  \hfill{\fontsize{6.8}{8}\selectfont\color{black!45}%
  \ifbeamer@inappendix A\insertframenumberinappendix
  \else\insertframenumber/\insertmainframenumber\fi}%
  \hspace*{.35cm}\vspace*{1.1mm}%
}
