% Local adaptation: reusable cover and section agenda from the 2026-10-15 reference.
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[circle]
% Keep the single-line cover unchanged; move the subtitle for a two-line title.
\newif\ifTongjiLongTitle
\TongjiLongTitlefalse
\setbeamertemplate{title page}{%
  \ifTongjiLongTitle
    \def\TongjiCoverSubtitleY{-5.43cm}%
  \else
    \def\TongjiCoverSubtitleY{-4.88cm}%
  \fi
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east,inner sep=0pt]
      at ([xshift=-.15cm,yshift=-.12cm]current page.north east)
      {\TongjiCoverBrand};
    \fill[TJBluePrimary]
      ([yshift=-2.42cm]current page.north west) rectangle
      ([yshift=-6.03cm]current page.north east);
    \node[text=white,text width=14.3cm,align=center,
      font=\fontsize{28}{34}\selectfont\bfseries]
      at ([yshift=-3.90cm]current page.north) {\inserttitle};
    \node[text=white,text width=14.3cm,align=center,
      font=\fontsize{14}{18}\selectfont]
      at ([yshift=\TongjiCoverSubtitleY]current page.north) {\insertsubtitle};
    \node[text=Ink,text width=14cm,align=center,font=\fontsize{12}{16}\selectfont]
      at ([yshift=-7.12cm]current page.north) {\insertauthor};
    \node[text=Muted,text width=14cm,align=center,font=\fontsize{10.5}{14}\selectfont]
      at ([yshift=-7.63cm]current page.north) {\insertinstitute};
    \node[text=TJBluePrimary,font=\fontsize{12}{16}\selectfont\bfseries]
      at ([yshift=-8.34cm]current page.north) {\insertdate};
  \end{tikzpicture}%
}
\setbeamertemplate{section in toc}{%
  \ifnum\inserttocsectionnumber=\value{section}
    \def\agendaColor{TJAgendaActive}%
  \else
    \def\agendaColor{TJBluePrimary}%
  \fi
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \fill[\agendaColor] (0,0) rectangle (1,-.82);
    \draw[black!25,line width=.35pt] (1.30,0) rectangle (11.55,-.82);
    \node[anchor=center,text=white,text width=1cm,align=center,inner sep=0pt,
      font=\fontsize{20}{24}\selectfont\bfseries]
      at (.5,-.41) {\zhnumber{\inserttocsectionnumber}};
    \node[anchor=west,text=\agendaColor,text width=9.9cm,align=left,inner sep=0pt,
      font=\fontsize{20}{24}\selectfont\bfseries]
      at (1.41,-.41) {\inserttocsection};
  \end{tikzpicture}%
}
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=west,text=black,font=\fontsize{23}{28}\selectfont\bfseries]
      at ([xshift=.7cm,yshift=-.9cm]current page.north west) {汇报提纲};
    \node[anchor=north west,inner sep=0pt,text width=11.55cm]
      at ([xshift=1.65cm,yshift=-1.37cm]current page.north west)
      {\tableofcontents[part=0,hideallsubsections]};
  \end{tikzpicture}%
}
\newcommand{\sectionagenda}{%
  \begin{frame}[plain,noframenumbering]
    \sectionpage
  \end{frame}%
}
\AtBeginSection[]{\ifbeamer@inappendix\else\sectionagenda\fi}
